# =================================
# Application
# =================================
APP_NAME="Yari_Service_API"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Api para Yari, una plaraforma pra inventario de emprendedores y pequeñas empresas"

# true  → activa /docs, /redoc, /openapi.json y extiende el tiempo de token
# false → modo producción (rutas de docs desactivadas)
DEBUG=True


# =================================
# MongoDB Atlas (Cloud Database)
# =================================
# Obtén tu connection string desde: https://cloud.mongodb.com
# Formato: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>
MONGODB_URL=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?appName=<AppName>
MONGODB_DB_NAME=laboratorios_db


# =================================
# JWT (Authentication)
# =================================
# Genera una clave secreta segura con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CAMBIA_ESTO_POR_UNA_CLAVE_SECRETA_SEGURA_DE_AL_MENOS_32_CHARS
ALGORITHM=HS256

# Duración del token en minutos según el modo
ACCESS_TOKEN_EXPIRE_MINUTES_DEV=1440    # 1 día  — usado cuando DEBUG=True
ACCESS_TOKEN_EXPIRE_MINUTES_PROD=180    # 3 horas — usado cuando DEBUG=False


# =================================
# Cloudinary (Image & Video Storage)
# =================================
# Crea una cuenta en: https://cloudinary.com
# Encuentra tus credenciales en el Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_FOLDER_NAME=LABORATORIOS


# =================================
# CORS (Cross-Origin Resource Sharing)
# =================================
# Orígenes permitidos en desarrollo (DEBUG=True) — separados por coma
DEV_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175"

# Orígenes permitidos en producción (DEBUG=False) — separados por coma
PROD_ORIGINS="https://tudominio.com,https://www.tudominio.com"


# =================================
# Initial Seed Data (Administradores iniciales)
# =================================
# Estos datos se usan al correr el seed para crear los primeros administradores.
# Usa contraseñas fuertes: mínimo 8 caracteres, mayúsculas, minúsculas y números.

SEED_ADMIN_EMAIL_1=admin1@tudominio.com
SEED_ADMIN_NAME_1=Admin
SEED_ADMIN_LASTNAME_1=Uno
SEED_ADMIN_USERNAME_1=adminuno
SEED_ADMIN_PASSWORD_1=AdminPass123

SEED_ADMIN_EMAIL_2=admin2@tudominio.com
SEED_ADMIN_NAME_2=Admin
SEED_ADMIN_LASTNAME_2=Dos
SEED_ADMIN_USERNAME_2=admindos
SEED_ADMIN_PASSWORD_2=AdminPass321
